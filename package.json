{
  "name": "agent-bus",
  "version": "0.12.7",
  "private": true,
  "license": "MIT",
  "description": "Local broker connecting Claude Code, Codex and GitHub Copilot sessions to Slack and to each other.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run format:check && npm test",
    "broker": "node --disable-warning=ExperimentalWarning src/broker/main.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/bolt": "^5.1.0",
    "@slack/web-api": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml}": "prettier --write",
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ]
  }
}
